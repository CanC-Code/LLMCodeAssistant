<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is DrawerLayout (required for the navigation drawer).

    The main content area is a FrameLayout so the floating menu button can
    overlay the fragment container using layout_gravity — this is the correct
    pattern for a draggable FAB overlay. Negative margins in a LinearLayout
    are not supported and cause InflateException on Android.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ─────────────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Vertical stack: fragment area + persistent bottom LLM bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- All fragments live here -->
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Persistent quick-send bar pinned to the bottom of every screen -->
            <LinearLayout
                android:id="@+id/llm_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#E0E0E0"
                android:elevation="4dp">

                <EditText
                    android:id="@+id/llm_input_global"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Select a model (Settings &amp; Model)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:padding="8dp"
                    android:background="#FFFFFF"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/llm_send_global"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!--
            Floating draggable menu button — overlaid via FrameLayout's z-ordering.
            layout_gravity positions it over the fragment area without disrupting
            the LinearLayout's measurement/layout pass.
            layout_marginTop="56dp" clears the default ActionBar height so the
            button starts just below it.
        -->
        <ImageView
            android:id="@+id/floatingMenuButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="60dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:padding="10dp"
            android:elevation="8dp"
            android:contentDescription="Menu"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <!-- ── Navigation Drawer ────────────────────────────────────────────────── -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>
