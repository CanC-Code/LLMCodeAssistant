<?xml version="1.0" encoding="utf-8"?>
<!--
    LLM chat fragment layout.

    New in this revision:
    - diffPanel (hidden by default): shown when the LLM produces a code suggestion.
      Contains a scrollable diff preview (blue=addition, red=deletion) and
      Apply / Reject buttons.
    - typingIndicator uses proper XML character escapes (no mojibake).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Project / active-file context badge -->
    <TextView
        android:id="@+id/projectBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:background="#0077CC"
        android:visibility="gone"
        android:singleLine="true"
        android:ellipsize="end"
        android:fontFamily="monospace" />

    <!-- Diff suggestion panel (GONE until LLM produces a code block) -->
    <LinearLayout
        android:id="@+id/diffPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0F8FF"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x1F4CB; LLM Suggested Changes"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#003366"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Addition"
                android:textSize="11sp"
                android:textColor="#003366"
                android:background="#CCE5FF"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- Deletion"
                android:textSize="11sp"
                android:textColor="#660000"
                android:background="#FFCCCC"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scrollbars="vertical"
            android:background="#1A1A2E">

            <TextView
                android:id="@+id/diffPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="12sp"
                android:textColor="#D4D4D4"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/btnRejectDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x2715; Reject"
                android:textColor="#B00020"
                android:layout_marginEnd="8dp"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnApplyDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x2714; Apply"
                android:textColor="#FFFFFF"
                android:backgroundTint="#28A745" />

        </LinearLayout>

    </LinearLayout>

    <!-- Chat transcript -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/chatOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#212121"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true"
            android:fontFamily="monospace" />

    </ScrollView>

    <!-- Thinking indicator -->
    <TextView
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text="&#x1F916; Thinking&#x2026;"
        android:textSize="12sp"
        android:textColor="#888888"
        android:visibility="gone" />

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#F0F0F0"
        android:elevation="4dp">

        <EditText
            android:id="@+id/inputBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ask LLM&#x2026;"
            android:minLines="1"
            android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/sendBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEND"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0077CC" />

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR"
                android:textSize="11sp"
                android:textColor="#B00020"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
