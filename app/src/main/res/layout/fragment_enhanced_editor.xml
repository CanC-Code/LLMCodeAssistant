<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E1E">

    <!-- Editor toolbar -->
    <LinearLayout
        android:id="@+id/editorToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#2D2D2D"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Undo -->
        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#CCCCCC"
            android:contentDescription="Undo" />

        <!-- Redo -->
        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#CCCCCC"
            android:contentDescription="Redo"
            android:layout_marginStart="4dp" />

        <!-- Save -->
        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_save"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#5CB85C"
            android:contentDescription="Save"
            android:layout_marginStart="4dp" />

        <!-- Ask LLM -->
        <ImageButton
            android:id="@+id/btnAskLlm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#0099FF"
            android:contentDescription="Ask LLM about this file"
            android:layout_marginStart="4dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Line:Col indicator -->
        <TextView
            android:id="@+id/lineColIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ln 1, Col 1"
            android:textSize="11sp"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:paddingEnd="8dp" />

    </LinearLayout>

    <!-- Editor body: line numbers + code area side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Line numbers -->
        <ScrollView
            android:id="@+id/lineNumberScroll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/lineNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:textSize="14sp"
                android:textColor="#858585"
                android:background="#252525"
                android:lineSpacingMultiplier="1.0" />

        </ScrollView>

        <!-- Code editor area -->
        <HorizontalScrollView
            android:id="@+id/editorScrollContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="horizontal">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/editorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="600dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:textColor="#D4D4D4"
                    android:importantForAutofill="no"
                    android:lineSpacingMultiplier="1.0" />

            </ScrollView>

        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
